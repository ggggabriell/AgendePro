CREATE TABLE clientEntity (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL,
    email TEXT,
    phone TEXT,
    category TEXT NOT NULL,
    notes TEXT,
    birthday TEXT,
    address TEXT,
    gender TEXT,
    createdAt INTEGER NOT NULL,
    updatedAt INTEGER NOT NULL
);

selectAll:
SELECT * FROM clientEntity;

selectById:
SELECT * FROM clientEntity WHERE id = ?;

insertClient:
INSERT INTO clientEntity(
    name, email, phone, category, notes, birthday, address, gender, createdAt, updatedAt
)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

deleteById:
DELETE FROM clientEntity WHERE id = ?;

updateClient:
UPDATE clientEntity
SET name = ?, email = ?, phone = ?, category = ?, notes = ?, birthday = ?, address = ?, gender = ?, updatedAt = ?
WHERE id = ?;